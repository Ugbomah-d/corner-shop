# Supabase → Project Settings → API (project URL only, no /rest/v1)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Mailgun → Sending → Domain settings / API keys
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=sandboxXXXX.mailgun.org
# Use https://api.eu.mailgun.net if your Mailgun domain is in the EU region
MAILGUN_API_BASE=https://api.mailgun.net
MAILGUN_FROM="Corner Shop <postmaster@sandboxXXXX.mailgun.org>"
